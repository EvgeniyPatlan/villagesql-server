# Acceptance test for a variable-length, PARAMETERIZED custom type:
# persisted_length = -1 that is resolved per-parameterization through
# int_to_params + resolve_params (the SVECTOR/TVECTOR shape). Sibling to
# extension_varlen_noparam_create_table, which covers the NON-parameterized
# variable-length case (persisted_length stays -1, length decided per value).
#
# Fixture: vsql_test_only exposes PVEC, a vector of N little-endian int16
# values. PVEC(N) stores exactly N*2 bytes. The integer shorthand PVEC(N) is
# translated to a "dimension=N" parameter by int_to_params (which validates
# 1..256); resolve_params then computes the concrete persisted_length (N*2)
# from that parameter.

--echo # Install the extension that registers the parameterized type PVEC.
INSTALL EXTENSION vsql_test_only;

--echo # The integer shorthand PVEC(N) goes through int_to_params: N is
--echo # validated and stored as a type parameter; resolve_params then sizes the
--echo # column to N*2 bytes. Columns of different N coexist in one table.
CREATE TABLE vectors (
  id INT PRIMARY KEY,
  v3 PVEC(3),
  v5 PVEC(5)
);

--echo # Each value is parsed by from_string against its column's resolved
--echo # dimension and round-trips through to_string.
INSERT INTO vectors VALUES (1, '[1,2,3]', '[10,20,30,40,50]');
INSERT INTO vectors VALUES (2, '[-1,0,1]', '[0,0,0,0,0]');

SELECT id, v3, v5 FROM vectors ORDER BY id;

--echo # The explicit canonical parameter form is equivalent to the shorthand.
CREATE TABLE vectors_kv (id INT PRIMARY KEY, v PVEC('dimension=3'));
INSERT INTO vectors_kv VALUES (1, '[7,8,9]');
SELECT id, v FROM vectors_kv ORDER BY id;
DROP TABLE vectors_kv;

--echo # A non-positive dimension is rejected by the parser before int_to_params.
--error ER_PARSE_ERROR
CREATE TABLE bad_zero (id INT, v PVEC(0));

--echo # A positive but out-of-range dimension reaches int_to_params, which
--echo # rejects it with the extension's own message.
--error ER_PARSE_ERROR
CREATE TABLE bad_big (id INT, v PVEC(300));

--echo # from_string enforces the resolved dimension: a wrong element count for
--echo # the column's N (here 2 elements into PVEC(3)) is rejected.
--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO vectors VALUES (3, '[1,2]', '[1,2,3,4,5]');

--echo # The rejected row was not inserted; the table is unchanged.
SELECT id, v3, v5 FROM vectors ORDER BY id;

--echo # Clean up.
DROP TABLE vectors;
UNINSTALL EXTENSION vsql_test_only;
