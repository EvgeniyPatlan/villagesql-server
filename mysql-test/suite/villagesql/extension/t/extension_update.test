# Test INSTALL EXTENSION ... UPDATE
# Verifies that updating an extension changes to_string output and VDF behavior
# while preserving existing column data (binary-compatible storage).

--let $veb_dir = $MYSQLTEST_VARDIR/veb
--exec mkdir -p $veb_dir

--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--let $restart_parameters = restart: --veb-dir=$veb_dir
--source include/restart_mysqld.inc

--echo # Build and install v1 of update_test extension
--let $extension_name = update_test
--let $extension_version = 1.0.0
--let $extension_source = $MYSQL_TEST_DIR/suite/villagesql/std_data/update_v1.cc
--let $extension_versioned = 1
--source include/villagesql/create_extension_sdk.inc

INSTALL EXTENSION update_test;

--echo # Verify v1 is installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS;

--echo # Create table and insert rows using the COUNTER type
CREATE TABLE t (id INT PRIMARY KEY, val update_test.COUNTER);
INSERT INTO t VALUES (1, '10');
INSERT INTO t VALUES (2, '20');
INSERT INTO t VALUES (3, '5');

--echo # v1: to_string produces "v1:N", counter_double returns N*2
SELECT id, update_test.counter_to_string(val) AS str,
       update_test.counter_double(val) AS doubled
FROM t ORDER BY id;

--echo # Build update_test_incompatible: drops the COUNTER type entirely (should be rejected)
--let $extension_name = update_test
--let $extension_version = 2.0.0-bad
--let $extension_source = $MYSQL_TEST_DIR/suite/villagesql/std_data/noop_extension.cc
--let $extension_versioned = 1
--source include/villagesql/create_extension_sdk.inc

SET GLOBAL offline_mode = ON;
--echo # Update to a version that drops the COUNTER type must fail
--error ER_VILLAGESQL_GENERIC_ERROR
INSTALL EXTENSION update_test VERSION '2.0.0-bad' UPDATE;
SET GLOBAL offline_mode = OFF;

--echo # Verify the original v1 is still installed after the failed update
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS;
SELECT id, update_test.counter_to_string(val) AS str,
       update_test.counter_double(val) AS doubled
FROM t ORDER BY id;

--echo # Build v2 of update_test (same binary storage, new to_string and VDF behavior)
--let $extension_name = update_test
--let $extension_version = 2.0.0
--let $extension_source = $MYSQL_TEST_DIR/suite/villagesql/std_data/update_v2.cc
--let $extension_versioned = 1
--source include/villagesql/create_extension_sdk.inc

--echo # Update requires offline_mode = ON; without it the command must fail
--error ER_VILLAGESQL_GENERIC_ERROR
INSTALL EXTENSION update_test VERSION '2.0.0' UPDATE;

--echo # Enter offline mode and update
SET GLOBAL offline_mode = ON;
INSTALL EXTENSION update_test VERSION '2.0.0' UPDATE;
SET GLOBAL offline_mode = OFF;

--echo # Verify v2 is now installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS;

--echo # v2: to_string produces "v2:N", counter_double returns N*3
--echo # The stored binary data is unchanged, only the interpretation changes
SELECT id, update_test.counter_to_string(val) AS str,
       update_test.counter_double(val) AS doubled
FROM t ORDER BY id;

--echo # Clean up
DROP TABLE t;
UNINSTALL EXTENSION update_test;
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS;
