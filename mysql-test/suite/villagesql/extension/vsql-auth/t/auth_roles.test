# Test token-driven role activation via the vsql::preview::auth set_active_roles
# op. The vsql_auth_test extension, on the "-token-roles" token, stages two
# roles: vsql_role_granted (which this test grants to the account) and
# vsql_role_denied (which it does NOT grant). Verifies:
#   - the granted role is activated on the session (CURRENT_ROLE shows it)
#   - the ungranted requested role is silently skipped -- a token cannot
#     activate a role the DBA never granted (the no-escalation guarantee)
#   - the plain token stages no roles, so the account's default-role behavior is
#     unaffected (no roles active, since none are default here)
#
# Pairs with mysql_clear_password so the token arrives in the password slot
# (client uses --enable_cleartext_plugin), same as auth_basic.

--source include/not_windows.inc

# The "-token-roles" login intentionally requests an ungranted role, which the
# server correctly refuses and logs as a warning. That warning IS the expected
# behavior under test, so suppress it in the error-log check.
call mtr.add_suppression("VEF auth: role .* is not granted; skipping");

--echo #
--echo # Install the auth extension, create the account + roles, and grant only
--echo # ONE of the two roles the "-token-roles" login will request.
--echo #
INSTALL EXTENSION vsql_auth_test;

CREATE USER auth_user IDENTIFIED WITH vsql_auth_test;
CREATE USER vsql_auth_test_user;
GRANT PROXY ON vsql_auth_test_user TO auth_user;

CREATE ROLE vsql_role_granted;
CREATE ROLE vsql_role_denied;
# Only vsql_role_granted is granted to the mapped account. vsql_role_denied is
# created but NOT granted -- the token requesting it must not gain it.
GRANT vsql_role_granted TO vsql_auth_test_user;

--echo #
--echo # Login with the roles token: the granted role is active, the ungranted
--echo # requested role is skipped. CURRENT_ROLE() shows only vsql_role_granted.
--echo #
--exec $MYSQL --enable_cleartext_plugin --user=auth_user --password=vsql-auth-test-token-roles -e "SELECT CURRENT_USER(), CURRENT_ROLE()"

--echo #
--echo # Login with the plain token: no roles staged, so no roles are active
--echo # (the account has no default roles). CURRENT_ROLE() is NONE.
--echo #
--exec $MYSQL --enable_cleartext_plugin --user=auth_user --password=vsql-auth-test-token -e "SELECT CURRENT_ROLE()"

--echo #
--echo # Cleanup.
--echo #
UNINSTALL EXTENSION vsql_auth_test;
DROP USER auth_user;
DROP USER vsql_auth_test_user;
DROP ROLE vsql_role_granted;
DROP ROLE vsql_role_denied;
