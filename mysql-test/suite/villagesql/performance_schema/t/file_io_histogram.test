# Test performance_schema.file_io_histogram (VillageSQL).
#
# The table exposes the file I/O latency distribution per file event name,
# using the shared 450-bucket histogram scale. IO counts vary by platform, so
# this test asserts structural invariants (shape, bucket scale, monotonic CDF)
# rather than exact bucket populations, plus that at least one file event
# accumulates buckets once real IO has happened.

# Performance Schema is a mandatory, always-compiled engine, so no capability
# guard is needed.

# Ensure file I/O is instrumented and timed so buckets can accumulate,
# independent of the suite's default consumer/instrument configuration.
UPDATE performance_schema.setup_instruments
  SET ENABLED = 'YES', TIMED = 'YES'
  WHERE NAME LIKE 'wait/io/file/%';

--echo # Table exists with the expected columns.
SHOW COLUMNS FROM performance_schema.file_io_histogram;

--echo # Every instrumented file event has exactly NUMBER_OF_BUCKETS (450) rows.
SELECT COUNT(DISTINCT BUCKET_NUMBER) AS buckets_per_event
  FROM performance_schema.file_io_histogram
  GROUP BY EVENT_NAME
  LIMIT 1;

--echo # Bucket boundaries are the shared geometric scale: bucket 0 starts at 0,
--echo # each bucket's HIGH equals the next bucket's LOW.
SELECT BUCKET_NUMBER, BUCKET_TIMER_LOW, BUCKET_TIMER_HIGH
  FROM performance_schema.file_io_histogram
  WHERE EVENT_NAME = 'wait/io/file/innodb/innodb_data_file'
    AND BUCKET_NUMBER <= 3
  ORDER BY BUCKET_NUMBER;

--echo # LOW of bucket 0 must be 0.
SELECT BUCKET_TIMER_LOW = 0 AS first_bucket_starts_at_zero
  FROM performance_schema.file_io_histogram
  WHERE EVENT_NAME = 'wait/io/file/innodb/innodb_data_file'
    AND BUCKET_NUMBER = 0;

--echo # Generate file I/O, then confirm at least one event accumulated buckets.
CREATE TABLE t1 (id INT PRIMARY KEY, pad CHAR(255)) ENGINE=InnoDB;
--disable_query_log
let $n = 200;
while ($n) {
  eval INSERT INTO t1 VALUES ($n, REPEAT('x', 255));
  dec $n;
}
--enable_query_log
FLUSH TABLES t1;

SELECT COUNT(*) FROM t1;

--echo # The InnoDB data file accumulated real I/O in its histogram. This must
--echo # be non-zero: the 200 inserts + FLUSH write pages to the .ibd, whose I/O
--echo # is aggregated on the per-instance file stat. (A histogram that only read
--echo # the per-class stat would miss this and wrongly report 0.)
SELECT SUM(COUNT_BUCKET) > 0 AS data_file_io_recorded
  FROM performance_schema.file_io_histogram
  WHERE EVENT_NAME = 'wait/io/file/innodb/innodb_data_file';

--echo # COUNT_BUCKET_AND_LOWER is a monotonic non-decreasing CDF per event.
--echo # Verify no violations exist.
SELECT COUNT(*) AS cdf_violations
  FROM (
    SELECT EVENT_NAME, BUCKET_NUMBER, COUNT_BUCKET_AND_LOWER,
           LAG(COUNT_BUCKET_AND_LOWER)
             OVER (PARTITION BY EVENT_NAME ORDER BY BUCKET_NUMBER) AS prev
      FROM performance_schema.file_io_histogram
  ) c
  WHERE prev IS NOT NULL AND COUNT_BUCKET_AND_LOWER < prev;

--echo # BUCKET_QUANTILE is always within [0,1].
SELECT COUNT(*) AS quantile_out_of_range
  FROM performance_schema.file_io_histogram
  WHERE BUCKET_QUANTILE < 0 OR BUCKET_QUANTILE > 1;

--echo # TRUNCATE is supported and still leaves the full bucket grid in place
--echo # (it clears counts, not rows). Assert the row grid survives; post-truncate
--echo # counts are not asserted, as background I/O may repopulate immediately.
TRUNCATE TABLE performance_schema.file_io_histogram;
SELECT COUNT(DISTINCT BUCKET_NUMBER) AS buckets_per_event_after_truncate
  FROM performance_schema.file_io_histogram
  GROUP BY EVENT_NAME
  LIMIT 1;

--echo #
--echo # ==== file_io_histogram_sync_reads (intent-tagged sync single-page reads) ====
--echo #

--echo # The sync-reads table has the same shape as the all-I/O table.
SHOW COLUMNS FROM performance_schema.file_io_histogram_sync_reads;

--echo # Same 450-bucket grid, same event names as the all-I/O table.
SELECT COUNT(DISTINCT BUCKET_NUMBER) AS buckets_per_event
  FROM performance_schema.file_io_histogram_sync_reads
  GROUP BY EVENT_NAME
  LIMIT 1;

--echo # Restart to cold-start the buffer pool: the next access to t1 must fetch
--echo # its pages from disk via synchronous single-page reads (buf_read_page),
--echo # which is exactly the intent this histogram tags.
--source include/restart_mysqld.inc

--echo # Cold read of t1: forces synchronous single-page reads.
SELECT COUNT(*) FROM t1;

--echo # The sync-reads histogram recorded synchronous data-file reads.
SELECT SUM(COUNT_BUCKET) > 0 AS sync_reads_recorded
  FROM performance_schema.file_io_histogram_sync_reads
  WHERE EVENT_NAME = 'wait/io/file/innodb/innodb_data_file';

--echo # Intent split invariant: sync reads on the data file are a non-empty
--echo # SUBSET of all data-file I/O: 0 < sync_reads <= all_io. The strict lower
--echo # bound guards against a regression where BOTH histograms silently read an
--echo # empty per-class stat (the "0 <= 0" trap).
SELECT
  0 <
  (SELECT SUM(COUNT_BUCKET) FROM performance_schema.file_io_histogram_sync_reads
     WHERE EVENT_NAME = 'wait/io/file/innodb/innodb_data_file')
  AND
  (SELECT SUM(COUNT_BUCKET) FROM performance_schema.file_io_histogram_sync_reads
     WHERE EVENT_NAME = 'wait/io/file/innodb/innodb_data_file')
  <=
  (SELECT SUM(COUNT_BUCKET) FROM performance_schema.file_io_histogram
     WHERE EVENT_NAME = 'wait/io/file/innodb/innodb_data_file')
  AS sync_is_nonempty_subset_of_all;

--echo # The sync-reads histogram is confined to reads: write-only file classes
--echo # (e.g. the doublewrite buffer) never accumulate sync-read buckets.
SELECT SUM(COUNT_BUCKET) AS dblwr_sync_reads
  FROM performance_schema.file_io_histogram_sync_reads
  WHERE EVENT_NAME = 'wait/io/file/innodb/innodb_dblwr_file';

DROP TABLE t1;
