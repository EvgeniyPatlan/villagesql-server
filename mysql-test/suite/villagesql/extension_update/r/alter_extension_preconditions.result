INSTALL EXTENSION vsql_simple;
#
# Test 1: offline_mode must be ON
#
ALTER EXTENSION vsql_simple UPDATE TO '0.0.1';
ERROR HY000: Updating an extension requires the server to be in offline mode. Run SET GLOBAL offline_mode = ON before updating.
#
# Test 2: no non-admin connections may be open while ALTER runs
#
CREATE USER 'alter_test_user'@'localhost' IDENTIFIED BY 'pw';
SET DEBUG_SYNC=
'after_lock_offline_mode_acquire SIGNAL offline_paused WAIT_FOR offline_continue';
SET GLOBAL offline_mode = ON;
SET DEBUG_SYNC= 'now WAIT_FOR offline_paused';
# default: offline_mode is now ON but the non-admin session has not
# been killed yet — ALTER should fail at the active-connections check
ALTER EXTENSION vsql_simple UPDATE TO '0.0.1';
ERROR HY000: Cannot update extension: N non-admin connection(s) are still active. Kill them before running ALTER EXTENSION, or wait for them to finish.
SET DEBUG_SYNC= 'now SIGNAL offline_continue';
SET DEBUG_SYNC= 'RESET';
#
# Test 3: extension must be installed (the .veb stays on disk after
# UNINSTALL, so resolve_veb_version succeeds and the not-installed
# check fires on the missing catalog entry)
#
UNINSTALL EXTENSION vsql_simple;
ALTER EXTENSION vsql_simple UPDATE TO '0.0.1';
ERROR HY000: ALTER EXTENSION ... UPDATE TO failed: extension 'vsql_simple' is not installed
#
# Test 4: all preconditions met — ALTER succeeds. Updating to the
# same version is a degenerate no-op-style swap that exercises the
# full happy path without testing version-bump semantics.
#
INSTALL EXTENSION vsql_simple;
ALTER EXTENSION vsql_simple UPDATE TO '0.0.1';
UNINSTALL EXTENSION vsql_simple;
SET GLOBAL offline_mode = OFF;
DROP USER 'alter_test_user'@'localhost';
