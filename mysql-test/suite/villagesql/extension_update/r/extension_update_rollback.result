# Install update_test 1.0.0 (pre-built; v2 is also staged on disk)
INSTALL EXTENSION update_test VERSION '1.0.0';
CREATE TABLE t (id INT PRIMARY KEY, val update_test.COUNTER);
INSERT INTO t VALUES (1, '10'), (2, '20');
SET GLOBAL offline_mode = ON;
#
# Scenario 1: mark_extension_for_insertion fails. The preceding
# rewrite_column_and_sp_param_versions has already queued column-row
# updates; those must be rolled back along with the queued deletions.
#
SET @@SESSION.debug = '+d,villagesql_inject_update_mark_insert_fail';
Attempting to update update_test to 2.0.0 (expecting error)
ERROR HY000: Injected mark_extension_for_insertion failure for 'update_test'
SET @@SESSION.debug = '-d,villagesql_inject_update_mark_insert_fail';
# v1 still installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'update_test';
EXTENSION_NAME	EXTENSION_VERSION
update_test	1.0.0
# v1 VDF behavior still works (counter_to_string returns "v1:N")
SELECT id, update_test.counter_to_string(val) AS str FROM t ORDER BY id;
id	str
1	v1:10
2	v1:20
# custom_columns still references v1
SELECT * FROM villagesql.custom_columns;
db_name	table_name	column_name	extension_name	extension_version	type_name	type_parameters
test	t	val	update_test	1.0.0	COUNTER	{}
#
# Scenario 2: write_all_uncommitted_entries fails. All in-memory marks
# are queued (deletions, column-version rewrites, new insertions). The
# transaction must roll back all of them without leaving the victionary
# in a half-applied state.
#
SET @@SESSION.debug = '+d,villagesql_inject_update_write_fail';
Attempting to update update_test to 2.0.0 (expecting error)
ERROR HY000: Failed to write extension 'update_test' to table
SET @@SESSION.debug = '-d,villagesql_inject_update_write_fail';
# v1 still installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'update_test';
EXTENSION_NAME	EXTENSION_VERSION
update_test	1.0.0
# v1 VDF behavior still works
SELECT id, update_test.counter_to_string(val) AS str FROM t ORDER BY id;
id	str
1	v1:10
2	v1:20
# custom_columns still references v1
SELECT * FROM villagesql.custom_columns;
db_name	table_name	column_name	extension_name	extension_version	type_name	type_parameters
test	t	val	update_test	1.0.0	COUNTER	{}
#
# Control: same UPDATE without any injection succeeds, proving the
# test extension is sound and the earlier failures were the injections.
#
Updated update_test to 2.0.0
# v2 now installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'update_test';
EXTENSION_NAME	EXTENSION_VERSION
update_test	2.0.0
# v2 VDF behavior is in effect (counter_to_string returns "v2:N")
SELECT id, update_test.counter_to_string(val) AS str FROM t ORDER BY id;
id	str
1	v2:10
2	v2:20
# custom_columns now references v2
SELECT * FROM villagesql.custom_columns;
db_name	table_name	column_name	extension_name	extension_version	type_name	type_parameters
test	t	val	update_test	2.0.0	COUNTER	{}
SET GLOBAL offline_mode = OFF;
DROP TABLE t;
UNINSTALL EXTENSION update_test;
