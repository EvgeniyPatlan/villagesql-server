INSTALL EXTENSION update_test VERSION '1.0.0';
CREATE TABLE t (id INT PRIMARY KEY, val update_test.COUNTER, KEY (val));
INSERT INTO t VALUES (1, '10'), (2, '20'), (3, '5');
# ORDER BY val before ALTER (forces InnoDB compare on custom column)
SELECT id, update_test.counter_to_string(val) AS str FROM t ORDER BY val;
id	str
3	v1:5
1	v1:10
2	v1:20
SET GLOBAL offline_mode = ON;
Updated update_test to 2.0.0
SET GLOBAL offline_mode = OFF;
# Post-ALTER queries: each tries to force InnoDB's compare on the
# custom column. The optimizer may still choose a full table scan
# (which does NOT go through Custom_column::compare); FORCE INDEX
# makes it deterministic when supported. Any of these would crash
# if InnoDB still calls v1's compare fn and v1's .so is unmapped.
# 1. ORDER BY (filesort is possible; not a strong forcing function)
SELECT id, update_test.counter_to_string(val) AS str FROM t ORDER BY val;
id	str
3	v2:5
1	v2:10
2	v2:20
# 2. Equality lookup with FORCE INDEX -- should use the index
SELECT id, update_test.counter_to_string(val) AS str
FROM t FORCE INDEX (val) WHERE val = '10';
id	str
1	v2:10
# 3. Range scan with FORCE INDEX -- should use the index
SELECT id, update_test.counter_to_string(val) AS str
FROM t FORCE INDEX (val) WHERE val > '7' ORDER BY val;
id	str
1	v2:10
2	v2:20
# 4. EXPLAIN to confirm whether index is actually used
EXPLAIN SELECT id FROM t FORCE INDEX (val) WHERE val > '7';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	range	val	val	7	#	#	#	Using where; Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`t` FORCE INDEX (`val`) where (`test`.`t`.`val` > 'v2:7')
DROP TABLE t;
UNINSTALL EXTENSION update_test;
