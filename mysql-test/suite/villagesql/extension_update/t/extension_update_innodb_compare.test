# Regression test for the .so-lifetime hazard in ALTER EXTENSION UPDATE.
#
# Pre-fix history: after ALTER UPDATE committed and dlclose'd the old .so,
# the SQL layer's TABLE_SHARE and InnoDB's dict_table_t both held
# shared_ptr<TypeContext> references whose CompareOp::fn_ was a function
# pointer into the now-unmapped text segment. The next query that
# exercised InnoDB's compare on the custom column dereferenced the
# dangling pointer and crashed (deterministic on macOS, where dlclose
# actually unmaps; latent on glibc due to weak-symbol retention).
#
# Fix: before any swap work, derive the affected-table list from
# villagesql.custom_columns, acquire MDL_EXCLUSIVE on each affected table,
# flush their TABLE_SHAREs, and mark each InnoDB dict_table_t with
# discard_after_ddl via the storage hook. The MDL is held for the
# duration of the statement so the tables stay fenced through the swap
# and the post-commit dlclose; on statement end the MDL releases and
# fresh opens acquire TypeContexts against the new extension.
#
# This test exercises:
#   1. INSTALL v1, create a table with an indexed custom column.
#   2. ORDER BY val before ALTER (forces InnoDB compare on v1).
#   3. ALTER UPDATE to v2 (dlcloses v1).
#   4. Post-ALTER queries that force InnoDB index lookups on the custom
#      column (FORCE INDEX equality + range). These previously crashed.

INSTALL EXTENSION update_test VERSION '1.0.0';

CREATE TABLE t (id INT PRIMARY KEY, val update_test.COUNTER, KEY (val));
INSERT INTO t VALUES (1, '10'), (2, '20'), (3, '5');

--echo # ORDER BY val before ALTER (forces InnoDB compare on custom column)
SELECT id, update_test.counter_to_string(val) AS str FROM t ORDER BY val;

SET GLOBAL offline_mode = ON;
--let $extension_name = update_test
--let $extension_version = 2.0.0
--source include/villagesql/update_extension.inc
SET GLOBAL offline_mode = OFF;

--echo # Post-ALTER queries: each tries to force InnoDB's compare on the
--echo # custom column. The optimizer may still choose a full table scan
--echo # (which does NOT go through Custom_column::compare); FORCE INDEX
--echo # makes it deterministic when supported. Any of these would crash
--echo # if InnoDB still calls v1's compare fn and v1's .so is unmapped.

--echo # 1. ORDER BY (filesort is possible; not a strong forcing function)
SELECT id, update_test.counter_to_string(val) AS str FROM t ORDER BY val;

--echo # 2. Equality lookup with FORCE INDEX -- should use the index
SELECT id, update_test.counter_to_string(val) AS str
  FROM t FORCE INDEX (val) WHERE val = '10';

--echo # 3. Range scan with FORCE INDEX -- should use the index
SELECT id, update_test.counter_to_string(val) AS str
  FROM t FORCE INDEX (val) WHERE val > '7' ORDER BY val;

--echo # 4. EXPLAIN to confirm whether index is actually used
--replace_column 9 # 10 # 11 #
EXPLAIN SELECT id FROM t FORCE INDEX (val) WHERE val > '7';

DROP TABLE t;
UNINSTALL EXTENSION update_test;
