# When a pending update already exists for an extension, a second
# `ALTER ... AT RESTART` with a *different* target version is rejected:
# the operator must clear the pending action first.
#
# Re-issuing with the same target as the current installed version is
# treated as an implicit reset (covered in pending_reset.test).
#
# This test fixture only has one valid target (v2.0.0), so we exercise
# the rejection by issuing the same target twice -- the second call
# fails because there's already a pending update for v2.0.0.

INSTALL EXTENSION update_test VERSION '1.0.0';

ALTER EXTENSION update_test VERSION '2.0.0' AT RESTART;

# Re-queue with target != current and a pending action present: errors.
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER EXTENSION update_test VERSION '2.0.0' AT RESTART;

SELECT pending_version FROM INFORMATION_SCHEMA.EXTENSIONS
  WHERE extension_name = 'update_test';

UNINSTALL EXTENSION update_test;
