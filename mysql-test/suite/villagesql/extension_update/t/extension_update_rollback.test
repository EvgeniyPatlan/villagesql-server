# Test that ALTER EXTENSION ... UPDATE TO rolls back cleanly when a failure
# happens after the in-memory victionary has been mutated. The earlier failure
# paths (offline_mode precondition, type-dependent column, etc.) fire BEFORE
# any catalog mutation; this test exercises the harder paths where deletion
# marks and column-version rewrites have already been queued before failure.
#
# Two DBUG injection points in execute_upgrade are used:
#   villagesql_inject_update_mark_insert_fail  — fails between
#       rewrite_column_and_sp_param_versions (succeeded) and
#       mark_extension_for_insertion. Deletion marks and rewrites must roll
#       back.
#   villagesql_inject_update_write_fail        — fails after all marking but
#       before write_all_uncommitted_entries commits. The most delicate
#       rollback path.
#
# After each injected failure we verify:
#   - v1 is still the installed version
#   - the original VDF behavior still works (counter_to_string returns v1:N)
#   - the column entry in villagesql.custom_columns is still at v1.0.0
# Finally a control attempt without injection succeeds, proving the test
# extension is sound.

--source include/have_debug.inc

--echo # Install update_test 1.0.0 (pre-built; v2 is also staged on disk)
INSTALL EXTENSION update_test VERSION '1.0.0';

CREATE TABLE t (id INT PRIMARY KEY, val update_test.COUNTER);
INSERT INTO t VALUES (1, '10'), (2, '20');

SET GLOBAL offline_mode = ON;

--echo #
--echo # Scenario 1: mark_extension_for_insertion fails. The preceding
--echo # rewrite_column_and_sp_param_versions has already queued column-row
--echo # updates; those must be rolled back along with the queued deletions.
--echo #
SET @@SESSION.debug = '+d,villagesql_inject_update_mark_insert_fail';
--let $extension_name = update_test
--let $extension_version = 2.0.0
--let $update_expect_error = ER_VILLAGESQL_GENERIC_ERROR
--source include/villagesql/update_extension.inc
SET @@SESSION.debug = '-d,villagesql_inject_update_mark_insert_fail';

--echo # v1 still installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'update_test';

--echo # v1 VDF behavior still works (counter_to_string returns "v1:N")
SELECT id, update_test.counter_to_string(val) AS str FROM t ORDER BY id;

--echo # custom_columns still references v1
--source include/villagesql/query_custom_columns.inc

--echo #
--echo # Scenario 2: write_all_uncommitted_entries fails. All in-memory marks
--echo # are queued (deletions, column-version rewrites, new insertions). The
--echo # transaction must roll back all of them without leaving the victionary
--echo # in a half-applied state.
--echo #
SET @@SESSION.debug = '+d,villagesql_inject_update_write_fail';
--let $extension_name = update_test
--let $extension_version = 2.0.0
--let $update_expect_error = ER_VILLAGESQL_GENERIC_ERROR
--source include/villagesql/update_extension.inc
SET @@SESSION.debug = '-d,villagesql_inject_update_write_fail';

--echo # v1 still installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'update_test';

--echo # v1 VDF behavior still works
SELECT id, update_test.counter_to_string(val) AS str FROM t ORDER BY id;

--echo # custom_columns still references v1
--source include/villagesql/query_custom_columns.inc

--echo #
--echo # Control: same UPDATE without any injection succeeds, proving the
--echo # test extension is sound and the earlier failures were the injections.
--echo #
--let $extension_name = update_test
--let $extension_version = 2.0.0
--source include/villagesql/update_extension.inc

--echo # v2 now installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'update_test';

--echo # v2 VDF behavior is in effect (counter_to_string returns "v2:N")
SELECT id, update_test.counter_to_string(val) AS str FROM t ORDER BY id;

--echo # custom_columns now references v2
--source include/villagesql/query_custom_columns.inc

SET GLOBAL offline_mode = OFF;

DROP TABLE t;
UNINSTALL EXTENSION update_test;
