# `ALTER EXTENSION ... VERSION RESET` clears any pending action on the
# extension. Running it with no pending action is a no-op that emits a
# Note (so scripts can run it idempotently).
#
# Equivalent forms covered here:
#   * Explicit reset:  ALTER EXTENSION X VERSION RESET
#   * Implicit reset:  ALTER EXTENSION X VERSION '<current>' AT RESTART
#     (same target as currently installed version; clears any pending
#     update with a Note rather than queueing a redundant one).

INSTALL EXTENSION update_test VERSION '1.0.0';

# Queue a pending update, then reset it explicitly.
ALTER EXTENSION update_test VERSION '2.0.0' AT RESTART;
SELECT pending_version FROM INFORMATION_SCHEMA.EXTENSIONS
  WHERE extension_name = 'update_test';

ALTER EXTENSION update_test VERSION RESET;
SELECT pending_version FROM INFORMATION_SCHEMA.EXTENSIONS
  WHERE extension_name = 'update_test';

# Reset when there's nothing pending is a no-op with a Note.
ALTER EXTENSION update_test VERSION RESET;

# Implicit reset: queue a pending update, then re-issue with the current
# installed version as the target. The pending update is cleared.
ALTER EXTENSION update_test VERSION '2.0.0' AT RESTART;
SELECT pending_version FROM INFORMATION_SCHEMA.EXTENSIONS
  WHERE extension_name = 'update_test';

ALTER EXTENSION update_test VERSION '1.0.0' AT RESTART;
SELECT pending_version FROM INFORMATION_SCHEMA.EXTENSIONS
  WHERE extension_name = 'update_test';

# Re-issuing the current version with no pending action is a Note + no-op.
ALTER EXTENSION update_test VERSION '1.0.0' AT RESTART;

# Reset on a non-installed extension errors.
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER EXTENSION not_installed VERSION RESET;

UNINSTALL EXTENSION update_test;
