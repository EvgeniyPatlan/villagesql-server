CREATE TABLE t1 (val COMPLEX);
INSERT INTO t1 VALUES ('(1.0,2.0)'), ('(3.0,4.0)'), (NULL);
SELECT val, HEX(INTERNAL_REP(val)) FROM t1 ORDER BY val;
val	HEX(INTERNAL_REP(val))
NULL	NULL
(1,2)	000000000000F03F0000000000000040
(3,4)	00000000000008400000000000001040
SELECT val, LENGTH(INTERNAL_REP(val)) FROM t1 WHERE val IS NOT NULL ORDER BY val;
val	LENGTH(INTERNAL_REP(val))
(1,2)	16
(3,4)	16
SELECT INTERNAL_REP(val) FROM t1 WHERE val IS NULL;
INTERNAL_REP(val)
NULL
SELECT INTERNAL_REP(42);
ERROR HY000: Incorrect usage of INTERNAL_REP and non-custom-type argument
SELECT INTERNAL_REP('hello');
ERROR HY000: Incorrect usage of INTERNAL_REP and non-custom-type argument
SELECT INTERNAL_REP(val) FROM (SELECT 1 AS val) t;
ERROR HY000: Incorrect usage of INTERNAL_REP and non-custom-type argument
SET @v = vsql_complex.complex_from_string('(5.0,6.0)');
SELECT HEX(INTERNAL_REP(@v));
HEX(INTERNAL_REP(@v))
00000000000014400000000000001840
CREATE TABLE t2 (a COMPLEX, b COMPLEX);
INSERT INTO t2 VALUES ('(1.0,2.0)', '(1,2)');
SELECT INTERNAL_REP(a) = INTERNAL_REP(b) AS same_rep FROM t2;
same_rep
1
DROP TABLE t1, t2;
SET @v = NULL;
CREATE TABLE t3 (val COMPLEX);
INSERT INTO t3 VALUES ('(1.0,2.0)'), ('(3.0,4.0)'), (NULL);
SELECT val, DECODE_VALID(val) FROM t3 ORDER BY val;
val	DECODE_VALID(val)
NULL	NULL
(1,2)	1
(3,4)	1
SELECT DECODE_VALID(val) FROM t3 WHERE val IS NULL;
DECODE_VALID(val)
NULL
SELECT DECODE_VALID(42);
ERROR HY000: Incorrect usage of DECODE_VALID and non-custom-type argument
SELECT DECODE_VALID('hello');
ERROR HY000: Incorrect usage of DECODE_VALID and non-custom-type argument
DROP TABLE t3;
