CREATE TABLE t1 (id INT, group_id INT, val COMPLEX);
INSERT INTO t1 VALUES (3, 2, '(5.0,6.0)'), (1, 1, '(1.0,2.0)'), (2, 1, '(3.0,4.0)');
SELECT id, FIRST_VALUE(val) OVER (PARTITION BY group_id ORDER BY id) FROM t1;
id	FIRST_VALUE(val) OVER (PARTITION BY group_id ORDER BY id)
1	(1,2)
2	(1,2)
3	(5,6)
SELECT id, LAST_VALUE(val) OVER (PARTITION BY group_id ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM t1;
id	LAST_VALUE(val) OVER (PARTITION BY group_id ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
1	(3,4)
2	(3,4)
3	(5,6)
SELECT id, FIRST_VALUE(val) OVER (ORDER BY val) FROM t1;
id	FIRST_VALUE(val) OVER (ORDER BY val)
1	(1,2)
2	(1,2)
3	(1,2)
DROP TABLE t1;
